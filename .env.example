# Cloudflare Turnstile Keys
# Public Site Key (safe for frontend, exposed via Vite)
VITE_TURNSTILE_SITE_KEY=

# Private Secret Key (server-side only, set in Vercel Project Settings -> Environment Variables)
TURNSTILE_SECRET_KEY=

# Private Zapier Catch Hook URL (server-side only, set in Vercel Project Settings -> Environment Variables)
ZAPIER_WEBHOOK_URL=
