{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/custom-mobile-application-development",
      "destination": "/custom-mobile-application-development/index.html"
    },
    {
      "source": "/custom-mobile-application-development/",
      "destination": "/custom-mobile-application-development/index.html"
    },
    {
      "source": "/reviews",
      "destination": "/reviews/index.html"
    },
    {
      "source": "/reviews/",
      "destination": "/reviews/index.html"
    },
    {
      "source": "/email-signature",
      "destination": "/email-signature/index.html"
    },
    {
      "source": "/email-signature/",
      "destination": "/email-signature/index.html"
    },
    {
      "source": "/((?!assets/|images/|fonts/|custom-mobile-application-development/|reviews/|email-signature/|sitemap\\.xml).*)",
      "destination": "/index.html"
    }
  ]
}
